# Garmin Connect Personal API key (create one in Garmin Connect → Personal API).
# Read from the environment first, then from this file (./.env, or --env-file PATH).
# GARMIN_CONNECT_API_KEY is accepted as an alternative name.
GARMIN_API_KEY=

# Optional: archive database location.
# Default: the platform data dir, e.g. ~/.local/share/garmin-archive/archive.db on Linux.
# GARMIN_ARCHIVE_DB=/path/to/archive.db
